# Set through hosting secrets. Never commit populated copies.
NODE_ENV=production
PORT=10000
WORKSHOP_PUBLIC_ORIGIN=https://workshop.example.com
WORKSHOP_PREVIEW_ORIGIN=https://games.example.net
WORKSHOP_DATA_DIR=/var/data/workshop
WORKSHOP_PASSWORD_HASH=
WORKSHOP_SESSION_SECRET=
WORKSHOP_BACKUP_KEY=
WORKSHOP_DAILY_CALL_LIMIT=100
WORKSHOP_DAILY_TOKEN_LIMIT=500000
WORKSHOP_TOTAL_TOKEN_LIMIT=2000000
WORKSHOP_MAX_DATA_BYTES=250000000
WORKSHOP_MAX_RUNS=100
WORKSHOP_MAX_PROJECTS=100
GAME_BUILDER_PROVIDER=demo
GAME_BUILDER_BROWSER_QA=on
# Enable live generation only after revoking the previously shared credentials.
# GAME_BUILDER_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
