{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Game builder red-team evidence report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "createdAt", "mode", "overall", "summary", "results", "limits"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "mode": { "const": "local-scripted-no-key" },
    "overall": { "enum": ["pass", "fail", "incomplete"] },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["total", "pass", "fail", "not_tested"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 }, "pass": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 }, "not_tested": { "type": "integer", "minimum": 0 }
      }
    },
    "limits": { "type": "array", "items": { "type": "string" } },
    "results": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "surface", "automation", "expected", "status", "observed", "evidence", "limits"],
        "properties": {
          "id": { "type": "string", "pattern": "^(LOCAL|MODEL|HUMAN)-[0-9]{2}$" },
          "name": { "type": "string", "minLength": 1 }, "surface": { "type": "string", "minLength": 1 },
          "automation": { "enum": ["local", "model-required", "manual-required"] },
          "expected": { "type": "string", "minLength": 1 }, "status": { "enum": ["pass", "fail", "not_tested"] },
          "observed": { "type": "object" }, "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "limits": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
