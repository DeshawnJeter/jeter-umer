# Explicitly choose anthropic for real Claude agents or demo for no API calls.
GAME_BUILDER_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Leave global model overrides unset to use the job-specific Haiku/Sonnet mix.
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_CODING_CHECKER_MODEL=claude-sonnet-5-5
ANTHROPIC_MAX_CALLS=24
ANTHROPIC_MAX_TOTAL_TOKENS=128000
ANTHROPIC_MAX_OUTPUT_TOKENS=2048
ANTHROPIC_CODING_MAX_OUTPUT_TOKENS=6144
ANTHROPIC_MAX_RESPONSE_REPAIRS=2
ANTHROPIC_TIMEOUT_MS=60000
# Only the third coding-worker attempt, with unresolved defects, uses Opus.
ANTHROPIC_ENABLE_ESCALATION=true
# ANTHROPIC_ESCALATION_MODEL=claude-opus-5-5
GAME_BUILDER_BROWSER_QA=on
