# Demo mode requires no key and is the default. No environment file is auto-loaded.
GAME_BUILDER_PROVIDER=demo
# Set a fresh key privately in the server environment. Never paste or commit it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional global stage overrides, or e.g. OPENAI_GAMEPLAY_CHECKER_MODEL.
# OPENAI_WORKER_MODEL=gpt-4.1-mini
# OPENAI_CHECKER_MODEL=gpt-4.1-mini
OPENAI_MAX_CALLS=24
OPENAI_MAX_TOTAL_TOKENS=64000
OPENAI_MAX_OUTPUT_TOKENS=2048
OPENAI_TIMEOUT_MS=30000

# Automatic browser smoke gate; Windows requires installed Edge.
GAME_BUILDER_BROWSER_QA=on
# Set off only when deliberately using manual browser acceptance.
