# Demo mode requires no key and is the default. No environment file is auto-loaded.
GAME_BUILDER_PROVIDER=demo
# Select anthropic instead of openai to use Claude. Provider credentials and
# overrides are separate; only the selected provider's settings are read.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_UI_CHECKER_MODEL=claude-sonnet-5-5
# ANTHROPIC_MAX_CALLS=24
# ANTHROPIC_MAX_TOTAL_TOKENS=128000
# ANTHROPIC_MAX_OUTPUT_TOKENS=2048
# ANTHROPIC_CODING_MAX_OUTPUT_TOKENS=6144
# ANTHROPIC_MAX_RESPONSE_REPAIRS=2
# ANTHROPIC_TIMEOUT_MS=60000
# More expensive coding escalation is opt-in for Anthropic.
# ANTHROPIC_ENABLE_ESCALATION=true
# ANTHROPIC_ESCALATION_MODEL=claude-opus-5-5
# Set a fresh key privately in the server environment. Never paste or commit it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional global stage overrides, or e.g. OPENAI_GAMEPLAY_CHECKER_MODEL.
# OPENAI_WORKER_MODEL=gpt-4.1-mini
# OPENAI_CHECKER_MODEL=gpt-4.1-mini
OPENAI_MAX_CALLS=24
OPENAI_MAX_TOTAL_TOKENS=64000
OPENAI_MAX_OUTPUT_TOKENS=2048
OPENAI_TIMEOUT_MS=30000

# Automatic browser smoke gate; Windows requires installed Edge.
GAME_BUILDER_BROWSER_QA=on
# Set off only when deliberately using manual browser acceptance.
